# ==============================================================================
# Xlator - Hostinger Apache / LiteSpeed Configuration
# Optimized for Speed, Clean URLs, Dynamic Events, and Security
# ==============================================================================

# 1. Default Directory Index
DirectoryIndex index.php index.html

# 2. Prevent Directory Browsing
Options -Indexes

# 3. Custom Error Pages
ErrorDocument 404 /404.php

# 4. UTF-8 Encoding
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect .html requests to .php (clean migration)
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ %1.php [R=301,L]

    # Universal Admin Catch: Redirect ANY path with /admin (e.g. /program.php/admin, /events.php/admin, /anything/admin)
    RewriteRule ^.+?/admin(?:/(.*))?$ /admin/$1 [R=302,L,QSA]

    # Redirect /admin.php, /admin.html to /admin/
    RewriteRule ^admin\.(php|html?)$ /admin/ [R=301,L]

    # Admin aliases (e.g. /administrator, /backend, /cp)
    RewriteRule ^(administrator|backend|cp)(?:/(.*))?$ /admin/$2 [R=301,L,QSA]

    # Normalize /admin to /admin/
    RewriteRule ^admin$ /admin/ [R=301,L]

    # Rescue root-level accidental admin actions and route to /admin/
    RewriteRule ^(event-edit|event-delete|login|logout)(\.php)?$ /admin/$1.php [R=301,L,QSA]

    # Admin route aliases
    RewriteRule ^admin/(events|dashboard|home)/?$ admin/index.php [L,QSA]
    RewriteRule ^admin/(new|create|add)/?$ admin/event-edit.php [L,QSA]
    RewriteRule ^admin/delete/?$ admin/event-delete.php [L,QSA]
    RewriteRule ^admin/signin/?$ admin/login.php [L,QSA]
    RewriteRule ^admin/signout/?$ admin/logout.php [L,QSA]

    # Clean URLs: Allow accessing pages without .php extension (e.g., /program -> program.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L]

    # Clean URLs for admin pages (e.g. /admin/login -> admin/login.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/admin/$1.php -f
    RewriteRule ^admin/([^/]+)/?$ admin/$1.php [L]

    # Dynamic events detail route (e.g., /events/new-event-slug -> event-detail.php?slug=new-event-slug)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^events/([^/]+)/?$ event-detail.php?slug=$1 [L,QSA]
</IfModule>

# 5. Security: Protect sensitive files and directories
<FilesMatch "^\.(git|env|htaccess|htpasswd|ini|log)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 6. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 7. Enable Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# 8. Browser Caching (Expires Headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images & Favicons
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"

    # HTML
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
