# ==============================================================================
# Xlator Application Environment Configuration (Template)
# Copy this file to .env and configure your credentials
# ==============================================================================

# Admin Portal Credentials
ADMIN_USERNAME=xlator
ADMIN_PASSWORD=your_secure_password_here


# Notification Settings
ADMIN_EMAIL=hello@xlator.com

# Authenticated Gmail / Google Workspace sender mailbox
# Enable 2-Step Verification and use a Google App Password when available.
# SMTP_USERNAME is the From address; ADMIN_EMAIL is the recipient.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-sending-account@gmail.com
SMTP_PASSWORD=your_google_app_password_here
